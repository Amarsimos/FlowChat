{
  "name": "flow-chat-system",
  "version": "1.0.0",
  "description": "Transparent, click-through desktop overlay for FlowChat comments.",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.flowchat.system",
    "productName": "FlowChatSystem",
    "files": [
      "index.js",
      "preload.js",
      "overlay-preload.js",
      "input.html",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName} Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Amarsimos",
      "repo": "FlowChat"
    },
    "releaseInfo": {
      "releaseNotes": "## ダウンロード\n\n- **`FlowChatSystem Setup.exe`** をダウンロードして実行してください（インストール版・自動アップデート対応）\n- インストールしたくない場合は **`FlowChatSystem.zip`** を展開し、中の `FlowChatSystem.exe` を実行してください\n\n※ `.blockmap` と `latest.yml` は自動アップデート用のファイルです。ダウンロード不要です。\n※ 初回起動時に SmartScreen の警告が出た場合は「詳細情報」→「実行」を選んでください。"
    }
  }
}
